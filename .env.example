# ~/.cc-plugins/.env のテンプレート。
# 実値はこのリポジトリに置かない。コピーして使う:
#   mkdir -p ~/.cc-plugins && cp .env.example ~/.cc-plugins/.env && chmod 600 ~/.cc-plugins/.env
#
# plugin のスクリプトはリポジトリ外のファイルを原則参照しないが、
# ~/.cc-plugins/.env だけは環境ごとの設定の置き場として例外にしている。

# marketplace リポジトリのパス。/promote-check と /promote-skill が読む。
# 手順書に絶対パスを書かないためのもので、既定値は持たない（未設定なら止まる）。
CC_DEV_PLUGINS_DIR=<この公開 marketplace の絶対パス>
CC_PLUGINS_DIR=<私有 marketplace の絶対パス>

# /poc の scaffold 置き場。未設定なら ~/poc を使う。
CC_POC_DIR=<試作の置き場の絶対パス>
